#!/bin/bash
# Сколько клиентов (окно Codex, мост) сейчас подключено к общему серверу.
SP=$(launchctl print "gui/$(id -u)/com.$(id -un).codex-shared-server" 2>/dev/null | awk '/pid =/{print $3; exit}')
[ -z "$SP" ] && { echo 0; exit 1; }
T=$(readlink "$HOME/.codex-bridge/app-server.sock")
N=$(lsof -p "$SP" 2>/dev/null | grep -c "unix.*$T")
echo $(( N > 0 ? N - 1 : 0 ))
