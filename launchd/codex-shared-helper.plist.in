<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Постоянный общий режим Codex (шаблон; ставит codex-shared-on). Выключить: codex-shared-off -->
  <key>Label</key>
  <string>__LABEL_PREFIX__.codex-shared-helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/codex-shared-helper</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>WatchPaths</key>
  <array>
    <string>/private/tmp/codex-app-tools</string>
  </array>
  <key>ThrottleInterval</key>
  <integer>1</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.codex-bridge/helper.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.codex-bridge/helper.log</string>
</dict>
</plist>
